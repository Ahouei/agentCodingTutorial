{
  // Cloudflare Worker in front of the built site (./dist):
  //   - worker/index.ts renders per-page meta tags, real 404s, security headers, caching
  //   - worker/api.ts is the optional-account API (passwordless email sign-in + progress sync)
  // Deploy with `npm run deploy`, or push to main (see .github/workflows/deploy.yml).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-coding-tutorial",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // Custom Domain: Cloudflare creates the DNS record and HTTPS certificate for it.
  "routes": [{ "pattern": "start.ahouei.site", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zero-to-hero-db",
      "database_id": "1ceb0e42-3b92-4012-bef6-fd4fc4c40f32",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public Turnstile site key goes here once created (the secret key is a Worker secret).
    "TURNSTILE_SITE_KEY": "",
    "MAIL_FROM": "از صفر تا قهرمان <noreply@ahouei.site>"
  }
  // Secrets (never in this file): RESEND_API_KEY, TURNSTILE_SECRET_KEY
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
}
