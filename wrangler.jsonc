{
  // Cloudflare Workers config: serves the built site in ./dist as static assets.
  // Deploy with `npm run deploy`, or connect this repo in the dashboard
  // (Workers & Pages → Create → Import a repository) for deploy-on-push.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-coding-tutorial",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
